{
  "name": "@par-rt-db/client",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "TypeScript client for par-rt-db over HTTP and reactive WebSocket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulrobello/par-rt-db.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "development": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "lint": "biome lint src tests",
    "fmt": "biome format --write src tests",
    "fmt-check": "biome format src tests",
    "doc": "cd docs-toolchain && bun run typedoc --options ../typedoc.json",
    "coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary --exclude 'tests/integration/**'"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0"
  }
}
