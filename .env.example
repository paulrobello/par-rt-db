# Copy to .env on the deploy host and fill in. NEVER commit the real .env.
# Generate the two secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=changeme-random-hex
RTDB_ADMIN_KEY=changeme-random-hex

# Public origin of this deployment (must match the GitHub OAuth app callback base).
RTDB_PUBLIC_URL=https://rtdb.pardev.net

# Comma-separated browser origins allowed to complete OAuth and call the HTTP API (CORS).
# Set to the SPA origin(s) that will consume this DB. Also hot-reloadable via /admin/config.
RTDB_ALLOWED_ORIGINS=https://projects.pardev.net

# Comma-separated emails seeded into the server-wide OAuth admin allowlist at boot
# (manageable at runtime via GET/POST/DELETE /admin/admins). Leave blank to manage
# admins only through the dashboard/API after first boot.
RTDB_ADMIN_EMAILS=

# GitHub OAuth app (Homepage = RTDB_PUBLIC_URL, Callback = RTDB_PUBLIC_URL + /auth/callback).
# Leave blank to run without user login (machine tokens + admin still work; /auth/* returns 503).
RTDB_GITHUB_CLIENT_ID=
RTDB_GITHUB_CLIENT_SECRET=
# GitHub Enterprise overrides (leave default for github.com):
RTDB_GITHUB_BASE_URL=https://github.com
RTDB_GITHUB_API_URL=https://api.github.com

# Google OAuth app (Authorized redirect = RTDB_PUBLIC_URL + /auth/google/callback).
# Optional; leave blank to disable Google login (GitHub + machine tokens + admin still work).
RTDB_GOOGLE_CLIENT_ID=
RTDB_GOOGLE_CLIENT_SECRET=

# GitLab OAuth app (Authorized redirect = RTDB_PUBLIC_URL + /auth/gitlab/callback).
# Optional; leave blank to disable GitLab login.
RTDB_GITLAB_CLIENT_ID=
RTDB_GITLAB_CLIENT_SECRET=
# Self-hosted GitLab override (leave default for gitlab.com):
RTDB_GITLAB_BASE_URL=https://gitlab.com

# Generic OpenID Connect provider (Azure AD, Keycloak, Auth0, Okta, self-hosted).
# One impl for any standards-compliant IdP. Active only when all five are set;
# otherwise the /auth/oidc/* routes return 503. Authorized redirect =
# RTDB_PUBLIC_URL + /auth/oidc/callback. Fetch the endpoint URLs from your
# IdP's /.well-known/openid-configuration (the trait's sync authorize_url can't
# do live discovery, so endpoints are configuration).
RTDB_OIDC_CLIENT_ID=
RTDB_OIDC_CLIENT_SECRET=
RTDB_OIDC_AUTHORIZE_URL=
RTDB_OIDC_TOKEN_URL=
RTDB_OIDC_USERINFO_URL=

# Microsoft (Entra ID / Azure AD v2.0). Active only when client id + secret are
# set. Authorized redirect = RTDB_PUBLIC_URL + /auth/microsoft/callback.
#
# SECURITY: set TENANT to your SPECIFIC tenant GUID, not "common". The default
# "common" accepts any Entra tenant, and a tenant admin can set a user's `mail`
# attribute to any address (which Microsoft then emits as the `email` claim).
# par-rt-db keys identity on the signature-verified `sub`+`tid` pair (SEC-102),
# so a spoofed email can no longer adopt an existing account — but pinning the
# tenant closes the attack surface at the source (only your own admins can set
# mail attributes). See docs/OAUTH_SETUP.md for the full rationale.
RTDB_MICROSOFT_CLIENT_ID=
RTDB_MICROSOFT_CLIENT_SECRET=
RTDB_MICROSOFT_TENANT=common

# Sign in with Apple. Apple rejects a static client_secret: the server signs a
# short-lived ES256 JWT with the EC private key you register with Apple, so four
# pieces are required (all or nothing — /auth/apple/* return 503 otherwise).
# The private key is the PEM you download from Apple; in env stores that can't
# carry real newlines, escape them as \n (the server unescapes). Authorized
# redirect = RTDB_PUBLIC_URL + /auth/apple/callback (Apple POSTs to it via
# response_mode=form_post, and it must be registered exactly in your Services ID).
RTDB_APPLE_CLIENT_ID=
RTDB_APPLE_TEAM_ID=
RTDB_APPLE_KEY_ID=
RTDB_APPLE_PRIVATE_KEY=

RTDB_SESSION_TTL_DAYS=30

# Login-CSRF defense: bind OAuth state to the initiating browser via a
# double-submit nonce cookie (set at /begin, verified at /callback). On by
# default. Set to false/0/no only as break-glass (restores pre-hardening
# behavior). Cross-origin SDK consumers must send credentials:'include' on /begin.
RTDB_OAUTH_LOGIN_CSRF=true

# Anonymous authentication (off by default). When true, POST /auth/anonymous
# mints an ephemeral user + session for a credential-less guest, who then owns
# its own documents via per-row ownerField. A database must SEPARATELY opt in
# via PATCH /admin/db/{db}/anonymous-access (SEC-103): an anonymous principal
# is authorized only for opted-in databases, not every database. When false,
# the mint endpoint returns 403 FORBIDDEN. Opt-in per app.
RTDB_AUTH_ANONYMOUS_ENABLED=false
# SEC-103: session TTL (days) for anonymous principals. Deliberately short
# (default 1) so the ephemeral rows minted by the unauthenticated mint route
# expire quickly rather than living for the standard 30-day session TTL.
RTDB_ANONYMOUS_SESSION_TTL_DAYS=1
# SEC-103: per-IP rate limit (requests per minute) on POST /auth/anonymous.
# Without it an attacker can mint unbounded anonymous users/sessions by
# hitting the unauthenticated endpoint in a loop. 0 = unlimited (code
# default); the shipped default below turns the mitigation on out-of-the-box.
RTDB_ANONYMOUS_RATE_LIMIT_PER_IP_RPM=10

# SEC-109: per-IP rate limit (requests per minute) on POST /admin/login.
# Without it an attacker can brute-force the admin key unbounded over the public
# login endpoint. 0 = unlimited (code default); the shipped default below turns
# the mitigation on out-of-the-box. Each failure also increments
# rtdb_admin_auth_failures_total and logs at WARN — alert on a burst of those.
RTDB_ADMIN_RATE_LIMIT_PER_IP_RPM=10

# SEC-120: cookie Secure attribute. When true (the default) the Secure attribute
# is set on every session/CSRF cookie unconditionally, so a misconfigured proxy
# that strips X-Forwarded-Proto cannot cause a session cookie to be sent over
# plain HTTP. Set to false ONLY for local-http dev (http://localhost) — the
# browser rejects Secure cookies over plain http, so local dev needs this off.
RTDB_COOKIE_SECURE=true

# Webhook delivery registry (off by default). When true the committer enqueues
# one outbox row per matching document change at every durable tap site
# (mutate/scheduled/ttl/migrate) and a background worker POSTs the payload
# (at-least-once, exponential backoff) to each registered webhook URL.
RTDB_WEBHOOKS_ENABLED=false
# Webhook SSRF dev-escape hatch (SEC-001). When true the registration validator
# permits http:// URLs AND skips the private/loopback/metadata IP-range
# denylist, so a developer may point a webhook at a local HTTP receiver
# (http://127.0.0.1:<port>/...). Leave false in production — the worker also
# refuses to follow redirects, so a benign-on-registration URL cannot be
# bounced to an internal host.
RTDB_WEBHOOK_ALLOW_HTTP=false

# Durable audit log (off by default). When true the committer writes one
# rtdb.audit_log row per DocOp at every durable tap site (mutate/scheduled/
# ttl/migrate): ts_ms, db, table, op, doc_id, principal, source. Read via
# GET /admin/audit?db=&limit=&offset=. The table is ensured at boot only when
# enabled; writes are best-effort and never block a document write.
RTDB_AUDIT_LOG_ENABLED=false

RTDB_MAX_FILE_SIZE=52428800

# Mutation idempotency-key dedup window in milliseconds (default 300000 = 5 min).
# Hot-reloadable: PATCH /admin/config { "idempotencyTtlMs": ... } takes effect live.
RTDB_IDEMPOTENCY_TTL_MS=300000

# Per-database resource quotas (ENH-011). 0 = unlimited (quota disabled).
# Hot-reloadable: PATCH /admin/config { "maxTablesPerDb" | "maxStorageBytesPerDb"
# | "maxSubsPerDb": N } takes effect live, on the next read of
# state.runtime.hot.load(). A non-zero cap is enforced by the table-create,
# storage-upload, and subscribe code paths respectively.
RTDB_MAX_TABLES_PER_DB=0
RTDB_MAX_STORAGE_BYTES_PER_DB=0
RTDB_MAX_SUBS_PER_DB=0

# Quota counter cache TTL in seconds (default 60). 0 = no caching (recompute on
# every read). Boot-only — the cache lives outside HotConfig and is rebuilt from
# AppState on its own cadence.
RTDB_QUOTA_CACHE_TTL_SECS=60

# Idle-database reclamation threshold in seconds (ARC-102 step 4, default 0 =
# disabled). When non-zero, a background sweep retires a database's five per-db
# tasks (committer + scheduler + mutation-log cleanup + TTL reaper + quota
# warmer) once it has had no client activity for this long AND has no live
# subscriptions AND no pending scheduled jobs; the next request respawns them.
# Steps 1–3 already gate each poller's per-tick work, so this is opt-in capacity
# reclamation, not a correctness fix. Boot-only.
RTDB_DB_IDLE_RECLAIM_SECS=0

# Max steps a single admin dashboard mutation may touch (default 100; each DSL
# step touches ≤1 doc, so this caps affected docs).
RTDB_MAX_AFFECTED_DOCS=100

# Directory of static SPA build artifacts served same-origin at the catch-all
# route fallback (unset / empty / non-existent ⇒ API-only, no SPA served). In
# the docker deploy, the Dockerfile's `dashboard` stage copies the built SPA
# here (`/app/dashboard-dist`), so a frontend change ships via the standard
# `docker compose up -d --build` (image rebuild + container recreate) — it is
# NOT a live-mounted volume. Same-origin ⇒ the dashboard's API/WS calls need
# no RTDB_ALLOWED_ORIGINS entry.
RTDB_STATIC_DIR=

# Shadow-verify subscription-invalidation skips: verify 1 skip in every N by
# re-running the query anyway and comparing against the last pushed result. A
# divergence means invalidation under-approximated (a realtime update would have
# been dropped): it logs at ERROR, increments rtdb_subs_missed_pushes_total, and
# pushes the corrected result. Ships ON at 1000 (1-in-1000 sampling); 0 = off;
# 1 = every skip (integration tests). Each verification costs exactly the
# Postgres round-trip the skip avoided, so keep N large in production — this
# trades the optimization back for confidence. Alert on ANY increase in
# rtdb_subs_missed_pushes_total — a non-zero value is a correctness defect.
RTDB_SUBS_VERIFY_SKIP_EVERY=1000

# On-the-fly image transforms on storage serve (ENH-014). All optional.
RTDB_IMAGE_TRANSFORMS_ENABLED=true
RTDB_IMAGE_MAX_DIM=2048
RTDB_IMAGE_MAX_PIXELS=25000000
RTDB_IMAGE_CACHE_BYTES=268435456
RTDB_IMAGE_CONCURRENCY=4
RTDB_IMAGE_DEFAULT_QUALITY=80

# Realtime presence primitive (ENH-015). All optional; defaults mirror the
# server's code defaults. Presence is ON by default; set the master switch to
# false to disable it. When enabled, ephemeral per-/sync-connection presence
# sessions are held in-memory only (no committer, no Postgres, no durability)
# and broadcast coalesced at the interval below. See FEATURE_MATRIX #25.
RTDB_PRESENCE_ENABLED=true
RTDB_PRESENCE_MAX_STATE_BYTES=1024
RTDB_PRESENCE_MAX_ROOM_SIZE=100
RTDB_PRESENCE_MAX_ROOMS_PER_CONN=32
RTDB_PRESENCE_MAX_ROOM_BYTES=256
RTDB_PRESENCE_BROADCAST_INTERVAL_MS=50
RTDB_PRESENCE_UPDATE_LIMIT_PER_SEC=20
# Upper bound on a client-supplied presenceState ttlMs (default 300000 = 5 min).
# Over-cap is rejected (no clamping); minimum effective value is 1000ms.
RTDB_PRESENCE_MAX_TTL_MS=300000

# Postgres connection-pool ceiling (default 75). Multi-tenant default: the
# committer-per-db model holds a connection per active db during subscription
# fan-out re-runs, so the pool must scale with the number of active databases.
RTDB_POOL_MAX_CONNECTIONS=75

# In-memory pushed-schema cache bound (ARC-119). Entry-count cap on the
# per-process SchemaCache; LRU-evicted past the cap and transparently reloaded
# from Postgres. 0 = unbounded (prior behavior); default 1024 bounds a
# multi-tenant instance that creates and drops databases over time.
RTDB_SCHEMA_CACHE_MAX_ENTRIES=1024

# HTTP rate limiting (fixed-window, in-memory). 0 = unlimited (default), which
# preserves unlimited behavior. RTDB_RATE_LIMIT_PER_TOKEN_RPM caps each machine
# token; OAuth sessions carry no token id and are rate-limited per-db only.
# RTDB_RATE_LIMIT_PER_DB_RPM is shared across all principals of one database.
RTDB_RATE_LIMIT_PER_TOKEN_RPM=0
RTDB_RATE_LIMIT_PER_DB_RPM=0

# Document TTL reaper (best-effort expiry, boot-only — not hot-reloadable).
# RTDB_TTL_SWEEP_INTERVAL_SECS (default 60) is the per-db sweep cadence.
# RTDB_TTL_BATCH (default 5000) bounds rows deleted per table per sweep.
RTDB_TTL_SWEEP_INTERVAL_SECS=60
RTDB_TTL_BATCH=5000

# Managed pg_dump backup scheduler (off by default). When true, a background
# task runs pg_dump on RTDB_BACKUP_CRON (5-field UTC cron, default daily 03:00)
# into RTDB_BACKUP_DIR, keeping the newest RTDB_BACKUP_RETENTION dumps. Enable
# by setting RTDB_BACKUP_ENABLED=true; the docker image installs
# postgresql-client so pg_dump is present. See deploy/README.md §Backups.
RTDB_BACKUP_ENABLED=false
RTDB_BACKUP_CRON=0 3 * * *
RTDB_BACKUP_DIR=./backups
RTDB_BACKUP_RETENTION=7

# Per-IP rate limit on the unauthenticated public storage serve route
# `GET /storage/{id}` (SEC-004 / SEC-112). 0 = unlimited. The opaque blob id is
# not enumerable, but a holder of one valid id can otherwise hammer the route;
# the on-the-fly image-transform path (`?w=&h=&...`) amplifies cost per request.
# The shipped docker-compose default is 600 RPM (10/sec); the code default is 0
# so test/dev deploys without this file stay unlimited. Override to 0 only when
# an upstream proxy enforces its own per-IP cap. The rate-limit key prefers
# CF-Connecting-IP then the RIGHTMOST X-Forwarded-For hop (Cloudflare appends
# the real client there) — never the leftmost XFF (spoofable).
RTDB_STORAGE_RATE_LIMIT_PER_IP_RPM=0

# SEC-113: require a valid signed URL on every public storage fetch. false
# (default) keeps opaque-id bearer URLs working (Convex parity — anyone with
# the URL fetches the bytes). true makes `?exp=&sig=` mandatory; the mint
# endpoint (GET /api/storage/{db}/{id}/signed-url) is unaffected either way.
RTDB_STORAGE_REQUIRE_SIGNED_URLS=false

# Short git SHA baked into /healthz at build time. Set when building without .git
# (Docker build-arg); defaults to `git rev-parse --short HEAD`, else "unknown".
RTDB_BUILD_COMMIT=

RUST_LOG=info

# OpenTelemetry / OTLP distributed tracing export (ENH-018). Opt-in: the cargo
# `otel` feature must be compiled in, AND RTDB_OTEL_ENABLED=true turns on the
# OTLP layer at runtime. When off (the default) the server makes zero OTLP
# network calls — structured logs still go to stdout and aggregates to the
# /metrics Prometheus surface. Point ENDPOINT at an OTLP/gRPC collector
# (the standard 4317 port). SERVICE_NAME becomes the `service.name` resource
# attribute on every span. SAMPLE_RATIO is the head sampler ratio in [0.0,1.0]
# — keep it low in production; span cardinality stays bounded because the
# instrumented spans carry only `db`/`table` (never doc ids or content).
RTDB_OTEL_ENABLED=false
RTDB_OTEL_ENDPOINT=http://127.0.0.1:4317
RTDB_OTEL_SERVICE_NAME=par-rt-db
RTDB_OTEL_SAMPLE_RATIO=0.05
