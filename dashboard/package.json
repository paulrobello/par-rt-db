{
  "name": "@par-rt-db/dashboard",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8310 --strictPort",
    "dev:bg": "vite --port 8310 --strictPort &",
    "build": "bun run build:sdk && vite build",
    "build:sdk": "cd ../ts-client && bun run build",
    "preview": "vite preview --port 8310 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "fmt": "biome format --write src",
    "fmt-check": "biome format src",
    "test": "vitest run --passWithNoTests",
    "prepare": "bun run build:sdk"
  },
  "dependencies": {
    "@par-rt-db/client": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
