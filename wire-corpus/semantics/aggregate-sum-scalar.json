{
  "name": "aggregate-sum-scalar",
  "$comment": "Scalar aggregate: SUM over index.fields[eq.len()] — with eq=['todo'] on [status, order], the aggregate field is `order`. 3+1+2 = 6. Compared numeric-tolerantly so SQL numeric 6 and client f64 6.0 agree.",
  "schema": {
    "tables": {
      "tasks": {
        "fields": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "order": { "type": "number" }
        },
        "indexes": [
          { "name": "by_status_and_order", "fields": ["status", "order"] }
        ]
      }
    }
  },
  "seed": [
    { "name": "a", "status": "todo", "order": 3 },
    { "name": "b", "status": "todo", "order": 1 },
    { "name": "c", "status": "done", "order": 5 },
    { "name": "d", "status": "todo", "order": 2 }
  ],
  "op": {
    "query": {
      "table": "tasks",
      "index": "by_status_and_order",
      "eq": ["todo"],
      "aggregate": { "op": "sum" }
    }
  },
  "expect": 6
}
