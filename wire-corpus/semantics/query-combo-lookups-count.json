{
  "name": "query-combo-lookups-count",
  "$comment": "Rule 'lookups-excludes-count' from wire-corpus/query-combinations.json: lookups expand docs; over a count terminal it is meaningless. Representative violation: a collect-shaped query with a lookup and count:true. Pins BAD_REQUEST across all runners.",
  "schema": {
    "tables": {
      "users": {
        "fields": { "name": { "type": "string" } },
        "indexes": [
          { "name": "by_name", "fields": ["name"] }
        ]
      },
      "posts": {
        "fields": {
          "title": { "type": "string" },
          "authorId": { "type": "optional", "inner": { "type": "id", "table": "users" } }
        }
      }
    }
  },
  "seed": [
    { "doc": { "name": "Ann" }, "table": "users", "$id": "u_ann" },
    { "doc": { "title": "p1", "authorId": { "$idRef": "u_ann" } }, "table": "posts" }
  ],
  "op": {
    "query": {
      "table": "posts",
      "lookups": [{ "field": "authorId", "table": "users", "as": "author" }],
      "count": true
    }
  },
  "expect": {
    "error": { "code": "BAD_REQUEST" }
  }
}
