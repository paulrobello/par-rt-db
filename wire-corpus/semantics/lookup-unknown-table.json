{
  "name": "lookup-unknown-table",
  "$comment": "A lookup naming a table the schema does not declare is NOT_FOUND at compile time — the same code the parent table's unknown-name rejection uses.",
  "schema": {
    "tables": {
      "users": {
        "fields": { "name": { "type": "string" } }
      },
      "posts": {
        "fields": {
          "title": { "type": "string" },
          "authorId": { "type": "optional", "inner": { "type": "id", "table": "users" } }
        }
      }
    }
  },
  "seed": [
    { "doc": { "name": "Ann" }, "table": "users", "$id": "u_ann" },
    { "doc": { "title": "p1", "authorId": { "$idRef": "u_ann" } }, "table": "posts" }
  ],
  "op": {
    "query": {
      "table": "posts",
      "lookups": [{ "field": "authorId", "table": "ghost", "as": "author" }]
    }
  },
  "expect": {
    "error": { "code": "NOT_FOUND" }
  }
}
