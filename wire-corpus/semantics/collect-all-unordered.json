{
  "name": "collect-all-unordered",
  "$comment": "Baseline collect with no filter/order/index: every seeded doc is returned. Protocol order is unspecified without a sort key, so the comparison is unordered. Returned docs are the full stored body plus _id/_creationTime/_version, which normalize projects out.",
  "schema": {
    "tables": {
      "tasks": {
        "fields": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "order": { "type": "number" }
        },
        "indexes": [{ "name": "by_status", "fields": ["status"] }]
      }
    }
  },
  "seed": [
    { "name": "a", "status": "todo", "order": 3 },
    { "name": "b", "status": "todo", "order": 1 },
    { "name": "c", "status": "done", "order": 5 }
  ],
  "op": { "query": { "table": "tasks" } },
  "expect": [
    { "name": "a", "status": "todo", "order": 3 },
    { "name": "b", "status": "todo", "order": 1 },
    { "name": "c", "status": "done", "order": 5 }
  ],
  "unordered": true
}
