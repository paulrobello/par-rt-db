{
  "name": "paginate-first-page-next-cursor",
  "$comment": "First page of a full ordered scan over [status, order] asc with numItems=2 of 5 rows: page = the two 'done' docs in order-ascending (done < todo lexicographically), and a nextCursor must be present because rows remain. The cursor value itself is minted (encodes [status, order, created_at, id]) and is never compared — only presence.",
  "schema": {
    "tables": {
      "tasks": {
        "fields": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "order": { "type": "number" }
        },
        "indexes": [
          { "name": "by_status_and_order", "fields": ["status", "order"] }
        ]
      }
    }
  },
  "seed": [
    { "name": "a", "status": "todo", "order": 3 },
    { "name": "b", "status": "todo", "order": 1 },
    { "name": "c", "status": "done", "order": 5 },
    { "name": "d", "status": "todo", "order": 2 },
    { "name": "e", "status": "done", "order": 4 }
  ],
  "op": {
    "query": {
      "table": "tasks",
      "index": "by_status_and_order",
      "order": "asc",
      "paginate": { "numItems": 2 }
    }
  },
  "expect": {
    "docs": [
      { "name": "e", "status": "done", "order": 4 },
      { "name": "c", "status": "done", "order": 5 }
    ]
  },
  "expect_next_cursor": true
}
