{
  "name": "aggregate-multi-op",
  "$comment": "Wire-v2 (ARC-013): the aggregates alias->op map runs several ops in one pass, ungrouped. With eq=['todo'] on [status, order], the aggregate field is order (3,1,2 -> sum=6, count=3). Result is one object keyed by alias.",
  "schema": {
    "tables": {
      "tasks": {
        "fields": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "order": { "type": "number" }
        },
        "indexes": [{ "name": "by_status_and_order", "fields": ["status", "order"] }]
      }
    }
  },
  "seed": [
    { "name": "a", "status": "todo", "order": 3 },
    { "name": "b", "status": "todo", "order": 1 },
    { "name": "c", "status": "done", "order": 5 },
    { "name": "d", "status": "todo", "order": 2 }
  ],
  "op": {
    "query": {
      "table": "tasks",
      "index": "by_status_and_order",
      "eq": ["todo"],
      "aggregate": { "aggregates": { "total": "sum", "n": "count" } }
    }
  },
  "expect": { "total": 6, "n": 3 }
}
