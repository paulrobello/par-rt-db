{
  "name": "error-constraint-int64-above-max",
  "$comment": "Write-path constraint enforcement on int64: above the declared max fails with SCHEMA_VIOLATION.",
  "schema": {
    "tables": {
      "tasks": {
        "fields": {
          "name": { "type": "string" },
          "counter": { "type": "int64" }
        },
        "indexes": [{ "name": "by_name", "fields": ["name"] }],
        "constraints": { "counter": { "min": 1, "max": 100 } }
      }
    }
  },
  "seed": [],
  "op": {
    "txn": {
      "steps": [
        { "op": "insert", "table": "tasks", "doc": { "name": "ok", "counter": "101" } }
      ]
    }
  },
  "expect": { "error": { "code": "SCHEMA_VIOLATION" } }
}
