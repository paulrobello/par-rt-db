{
  "name": "search-trgm-min-similarity-zero-keeps-all",
  "$comment": "minSimilarity 0 is a floor every hit clears: ranked by similarity, exact match first.",
  "schema": {
    "tables": {
      "notes": {
        "fields": {
          "body": {
            "type": "string"
          }
        },
        "indexes": [
          {
            "name": "search_body",
            "fields": [
              "body"
            ],
            "search": true,
            "trgm": true
          }
        ]
      }
    }
  },
  "seed": [
    {
      "body": "convex"
    },
    {
      "body": "convexity in practice and more"
    }
  ],
  "op": {
    "query": {
      "table": "notes",
      "search": {
        "index": "search_body",
        "query": "convex",
        "mode": "trgm",
        "minSimilarity": 0
      }
    }
  },
  "expect": [
    {
      "body": "convex"
    },
    {
      "body": "convexity in practice and more"
    }
  ]
}
