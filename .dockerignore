# Keep the Docker build context lean — excludes are rebuilt inside the image.
# Secrets (.env*) are never committed; this is defense-in-depth.

# Build outputs & dependency caches (rebuilt in-image)
target/
**/node_modules/
**/dist/

# VCS & agent/tool local state
.git/
.gitignore
.claude/
.superpowers/
.impeccable/

# Secrets (never in the image)
.env
.env.*
!.env.example

# Non-runtime
docs/
deploy/
.DS_Store
